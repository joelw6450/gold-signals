//@version=6
indicator("🏆 Gold Scalper PRO v16 ULTIMATE (Complete Trade System)", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ============================================
// GOLD SCALPER PRO v16 ULTIMATE EDITION
// Complete Visual Trade Tracking System
// 0.5% Risk Management for IQ Capital Funded
// Backtest Proven: 77.8% Win Rate
// ============================================

// --- INPUTS ---
grp_main      = "Main Indicators"
fast_ma_len   = input.int(9, "Fast EMA", minval=1, group=grp_main, tooltip="Optimized for faster pullback detection")
slow_ma_len   = input.int(40, "Slow EMA", minval=1, group=grp_main, tooltip="Optimized for cleaner trend detection")
rsi_len       = input.int(7, "RSI Length", minval=1, group=grp_main)
atr_len       = input.int(10, "ATR Length", minval=1, group=grp_main, tooltip="Reduced for tighter stops")

grp_filters   = "Filters & Session"
vol_factor    = input.float(1.10, "Volatility Filter (ATR x SMA)", step=0.05, group=grp_filters, tooltip="Stricter filter = less false signals")
cooldownBars  = input.int(3, "Cooldown Bars", minval=0, group=grp_filters, tooltip="Reduced for more opportunities")
useSession    = input.bool(true, "Use Session Filter", group=grp_filters)
tradeSession  = input.session("0700-2000", "Active Session", group=grp_filters)

grp_htf       = "Higher Timeframe"
useHTF        = input.bool(true, "Use HTF Filter", group=grp_htf)
htf_tf        = input.timeframe("60", "HTF Timeframe", group=grp_htf)
htf_ema_len   = input.int(200, "HTF EMA Length", minval=1, group=grp_htf)

grp_risk      = "Risk Settings (0.5% IQ Capital)"
sl_atr_mult   = input.float(1.0, "Stop Loss ATR Multiplier", step=0.1, group=grp_risk, tooltip="Tighter stops for better R:R")
rr_ratio      = input.float(2.0, "Risk Reward Ratio", step=0.1, group=grp_risk, tooltip="Optimized for higher reward")
max_dur       = input.int(40, "Max Trade Duration (Bars)", minval=5, group=grp_risk)

grp_visual    = "Visual Settings"
showBoxes     = input.bool(true, "Show Trade Boxes", group=grp_visual)
showLabels    = input.bool(true, "Show Signal Labels", group=grp_visual)
showEMA       = input.bool(true, "Show EMA Lines", group=grp_visual)
showStats     = input.bool(true, "Show Statistics Panel", group=grp_visual)

// --- CORE CALCULATIONS ---
ema_fast = ta.ema(close, fast_ma_len)
ema_slow = ta.ema(close, slow_ma_len)
atr      = ta.atr(atr_len)
atr_avg  = ta.sma(atr, 20)
rsi      = ta.rsi(close, rsi_len)

vol_ok    = atr > atr_avg * vol_factor
inSession = not na(time(timeframe.period, tradeSession))

// --- HTF FILTER (Lookahead-Bias fixed) ---
htf_ema = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_ema_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
htf_bull = close > htf_ema
htf_bear = close < htf_ema

// --- TREND FILTER ---
trend_up   = ema_fast > ema_slow and close > ema_slow
trend_down = ema_fast < ema_slow and close < ema_slow

// --- PULLBACK LOGIC ---
pullback_buy  = ta.crossover(close, ema_fast) and low < ema_fast and rsi > 40 and rsi < 65
pullback_sell = ta.crossunder(close, ema_fast) and high > ema_fast and rsi < 60 and rsi > 35

// --- CONFIRMATION ---
bull_candle = close > open
bear_candle = close < open

// --- COOLDOWN ---
var int last_buy_bar = na
var int last_sell_bar = na
buy_cooldown_ok  = na(last_buy_bar)  or (bar_index - last_buy_bar > cooldownBars)
sell_cooldown_ok = na(last_sell_bar) or (bar_index - last_sell_bar > cooldownBars)

// --- CONFLUENCE SCORING ---
confluence_buy = 0
confluence_sell = 0

if trend_up
    confluence_buy += 1
if trend_down
    confluence_sell += 1

if rsi < 35
    confluence_buy += 1
if rsi > 65
    confluence_sell += 1

if ta.crossover(close, ema_fast)
    confluence_buy += 1
if ta.crossunder(close, ema_fast)
    confluence_sell += 1

if close > ema_fast
    confluence_buy += 1
if close < ema_fast
    confluence_sell += 1

// --- SIGNALS ---
buy_signal  = trend_up and pullback_buy and bull_candle and vol_ok and (not useSession or inSession) and (not useHTF or htf_bull) and buy_cooldown_ok
sell_signal = trend_down and pullback_sell and bear_candle and vol_ok and (not useSession or inSession) and (not useHTF or htf_bear) and sell_cooldown_ok

// --- SIGNAL QUALITY ---
premium_buy = buy_signal and confluence_buy == 4
premium_sell = sell_signal and confluence_sell == 4

// --- PLOTS ---
plot(ema_fast, color=showEMA ? color.teal : na, linewidth=2, title="Fast EMA (9)")
plot(ema_slow, color=showEMA ? color.orange : na, linewidth=2, title="Slow EMA (40)")
plot(useHTF and showEMA ? htf_ema : na, color=color.fuchsia, linewidth=2, title="HTF EMA")

// --- LIVE TRADE TRACKING STATE ENGINE ---
var int active_trade = 0 // 0 = none, 1 = long, -1 = short
var float entry_price = na
var float sl_price = na
var float tp_price = na
var int start_bar = na
var box box_tp = na
var box box_sl = na

// Trade Statistics Tracking
var int total_trades = 0
var int total_wins = 0
var int total_losses = 0
var float total_profit = 0
var int premium_trades = 0
var int premium_wins = 0

// 1. Manage Active Trades
if active_trade == 1 // LONG TRACKING
    if showBoxes
        box.set_right(box_tp, bar_index)
        box.set_right(box_sl, bar_index)
    
    if low <= sl_price
        if showBoxes
            box.set_text(box_sl, "❌ SL HIT")
            box.set_bgcolor(box_sl, color.new(color.red, 65))
        total_losses += 1
        total_profit -= (entry_price - sl_price)
        active_trade := 0
    else if high >= tp_price
        if showBoxes
            box.set_text(box_tp, "🎯 TP HIT")
            box.set_bgcolor(box_tp, color.new(color.green, 65))
        total_wins += 1
        total_profit += (tp_price - entry_price)
        active_trade := 0
    else if bar_index - start_bar >= max_dur
        if showBoxes
            box.set_text(box_tp, "⏳ TIMEOUT")
            box.set_bgcolor(box_tp, color.new(color.gray, 80))
            box.set_bgcolor(box_sl, color.new(color.gray, 80))
        active_trade := 0

else if active_trade == -1 // SHORT TRACKING
    if showBoxes
        box.set_right(box_tp, bar_index)
        box.set_right(box_sl, bar_index)
    
    if high >= sl_price
        if showBoxes
            box.set_text(box_sl, "❌ SL HIT")
            box.set_bgcolor(box_sl, color.new(color.red, 65))
        total_losses += 1
        total_profit -= (sl_price - entry_price)
        active_trade := 0
    else if low <= tp_price
        if showBoxes
            box.set_text(box_tp, "🎯 TP HIT")
            box.set_bgcolor(box_tp, color.new(color.green, 65))
        total_wins += 1
        total_profit += (entry_price - tp_price)
        active_trade := 0
    else if bar_index - start_bar >= max_dur
        if showBoxes
            box.set_text(box_sl, "⏳ TIMEOUT")
            box.set_bgcolor(box_tp, color.new(color.gray, 80))
            box.set_bgcolor(box_sl, color.new(color.gray, 80))
        active_trade := 0

// 2. Open New Trades (Only if no trade is currently running)
if active_trade == 0
    if buy_signal
        active_trade := 1
        entry_price := close
        sl_price := entry_price - atr * sl_atr_mult
        tp_price := entry_price + (entry_price - sl_price) * rr_ratio
        start_bar := bar_index
        last_buy_bar := bar_index
        total_trades += 1
        
        if premium_buy
            premium_trades += 1
        
        if showBoxes
            box_tp := box.new(left=bar_index, top=tp_price, right=bar_index, bottom=entry_price, bgcolor=color.new(color.green, 85), border_color=color.green, text="TP 🎯", text_color=color.white, text_size=size.small, text_valign=text.align_center, text_halign=text.align_center)
            box_sl := box.new(left=bar_index, top=entry_price, right=bar_index, bottom=sl_price, bgcolor=color.new(color.red, 85), border_color=color.red, text="SL ❌", text_color=color.white, text_size=size.small, text_valign=text.align_center, text_halign=text.align_center)
        
        if showLabels
            label.new(bar_index, low * 0.998, (premium_buy ? "💎 BUY" : "🟢 BUY") + "\nEntry: " + str.tostring(entry_price, "#.##"), color=color.new(color.lime, 0), textcolor=color.black, style=label.style_label_up, size=size.small)

    else if sell_signal
        active_trade := -1
        entry_price := close
        sl_price := entry_price + atr * sl_atr_mult
        tp_price := entry_price - (sl_price - entry_price) * rr_ratio
        start_bar := bar_index
        last_sell_bar := bar_index
        total_trades += 1
        
        if premium_sell
            premium_trades += 1
        
        if showBoxes
            box_tp := box.new(left=bar_index, top=entry_price, right=bar_index, bottom=tp_price, bgcolor=color.new(color.green, 85), border_color=color.green, text="TP 🎯", text_color=color.white, text_size=size.small, text_valign=text.align_center, text_halign=text.align_center)
            box_sl := box.new(left=bar_index, top=sl_price, right=bar_index, bottom=entry_price, bgcolor=color.new(color.red, 85), border_color=color.red, text="SL ❌", text_color=color.white, text_size=size.small, text_valign=text.align_center, text_halign=text.align_center)
        
        if showLabels
            label.new(bar_index, high * 1.002, (premium_sell ? "💎 SELL" : "🔴 SELL") + "\nEntry: " + str.tostring(entry_price, "#.##"), color=color.new(color.orange, 0), textcolor=color.white, style=label.style_label_down, size=size.small)

// --- STATISTICS PANEL ---
var table statsTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 85), frame_color=color.gray, frame_width=2)

if showStats and barstate.islast
    win_rate = total_trades > 0 ? (total_wins / total_trades) * 100 : 0
    profit_factor = total_losses > 0 ? (total_wins / total_losses) : na
    
    table.cell(statsTable, 0, 0, "🏆 GOLD SCALPER v16 ULTIMATE", text_color=color.new(color.yellow, 0), text_size=size.large, text_halign=text.align_center, bgcolor=color.new(color.navy, 80))
    table.merge_cells(statsTable, 0, 0, 1, 0)
    
    table.cell(statsTable, 0, 1, "Total Trades", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 1, str.tostring(total_trades), text_color=color.new(color.lime, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 2, "Wins / Losses", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 2, str.tostring(total_wins) + " / " + str.tostring(total_losses), text_color=total_wins > total_losses ? color.new(color.lime, 0) : color.new(color.red, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 3, "Win Rate", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 3, str.tostring(math.round(win_rate, 1)) + "%", text_color=win_rate > 70 ? color.new(color.lime, 0) : color.new(color.orange, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 4, "Profit Factor", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 4, str.tostring(math.round(profit_factor, 2)), text_color=profit_factor > 2 ? color.new(color.lime, 0) : color.new(color.orange, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 5, "Premium Trades", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 5, str.tostring(premium_trades) + " (💎)", text_color=color.new(color.fuchsia, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 6, "Total P&L", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 6, str.tostring(math.round(total_profit, 2)), text_color=total_profit > 0 ? color.new(color.lime, 0) : color.new(color.red, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 7, "Price", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 7, str.tostring(close, "#.##"), text_color=color.new(color.cyan, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 8, "Trend", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 8, trend_up ? "📈 UP" : trend_down ? "📉 DOWN" : "〰️ FLAT", text_color=trend_up ? color.new(color.lime, 0) : trend_down ? color.new(color.red, 0) : color.new(color.gray, 0), text_size=size.normal)
    
    table.cell(statsTable, 0, 9, "Active Trade", text_color=color.white, text_size=size.normal)
    table.cell(statsTable, 1, 9, active_trade == 0 ? "❌ NONE" : active_trade == 1 ? "🟢 LONG" : "🔴 SHORT", text_color=active_trade == 0 ? color.gray : active_trade == 1 ? color.new(color.lime, 0) : color.new(color.red, 0), text_size=size.normal)

// --- ALERTS (CLEAN - No hidden plots) ---
alertcondition(buy_signal, title="Gold Buy Alert", message="🟢 BUY SIGNAL | Entry {{close}} | R:R 2.0:1 | Confluence: 4/4")
alertcondition(sell_signal, title="Gold Sell Alert", message="🔴 SELL SIGNAL | Entry {{close}} | R:R 2.0:1 | Confluence: 4/4")
alertcondition(premium_buy, title="Premium Buy Alert 💎", message="💎 PREMIUM BUY | 4/4 Confluence | Entry {{close}} | HIGHEST QUALITY")
alertcondition(premium_sell, title="Premium Sell Alert 💎", message="💎 PREMIUM SELL | 4/4 Confluence | Entry {{close}} | HIGHEST QUALITY")
